rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: anyone can read, only the user themselves can write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Followers of {userId}: anyone can read; only the caller can add or
      // remove their own entry (i.e. follow/unfollow themselves from this
      // user's followers list).
      match /followers/{followerId} {
        allow read: if true;
        allow create, delete: if request.auth != null
          && request.auth.uid == followerId;
      }

      // People that {userId} follows: anyone can read; only the owner of
      // this user doc (i.e. userId themselves) can add or remove entries.
      match /following/{followingId} {
        allow read: if true;
        allow create, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // Users that {userId} has blocked. The owner can read or modify
      // their full block list. The blocked party can read just their own
      // entry to discover that they've been blocked (so a profile/feed
      // screen can render an "unavailable" state) — they can't enumerate
      // anyone else's blocks because the doc id has to match their uid.
      match /blocked/{blockedId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == blockedId);
        allow create, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Posts: anyone can read, authenticated users can create, owner can update/delete
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;

      // Comments subcollection: anyone can read, authenticated users can create,
      // only the comment author can delete their own comment.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

    // Trips: anyone can read, authenticated users can create (and must put
    // themselves as guideId), and only the trip's creator can update or
    // delete it. Booking the trip is a separate path — users modify only
    // the bookedBy/spotsLeft fields via the booking transaction, which we
    // allow as a narrow exception on update.
    match /trips/{tripId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.guideId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.guideId == request.auth.uid;

      // Updates: either the trip's owner can change anything, or any
      // authenticated user can change just the bookedBy array + spotsLeft
      // counter (the booking transaction).
      allow update: if request.auth != null
        && (
          resource.data.guideId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['bookedBy', 'spotsLeft'])
        );

      // Bookings: a private per-trip subcollection that snapshots each
      // registrant's contact info at booking time. Only the trip's guide
      // (creator) or the registrant themselves can read a given booking.
      // A user can only create/delete their OWN booking doc (doc id == uid).
      match /bookings/{userId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId
              || request.auth.uid ==
                 get(/databases/$(database)/documents/trips/$(tripId)).data.guideId);
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == userId;
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Conversations: only the participants of a conversation can read/write.
    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Messages subcollection: readable/writable only by conversation participants,
      // and a sender can only write their own senderId. Participants may
      // also mark a message as read (flip isRead from false to true) so
      // the recipient's unread indicators clear on open.
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    // Premium applications
    match /premium_applications/{docId} {
      allow read, write: if request.auth != null;
    }

    // Notifications: each doc belongs to a single recipient. Only the
    // recipient can read/update/delete their own notifications, and any
    // authenticated user can create one for someone else (e.g. when they
    // like a post). Cosmic broadcast notifications are also single-doc
    // writes (admin fans out to N docs client-side), so the same rule
    // applies: the actorUid must match the writer.
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && (
          resource.data.recipientUid == request.auth.uid
          || resource.data.actorUid == request.auth.uid
        );
    }
  }
}
